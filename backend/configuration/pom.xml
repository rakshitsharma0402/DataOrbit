<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rakshitsharma0402</groupId>
        <artifactId>dataorbit-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>configuration</artifactId>
    <name>DataOrbit Configuration</name>
    <description>Startup settings and immutable classification-policy persistence.</description>

    <dependencies>
        <!-- @ConfigurationProperties only; no web or auto-configuration. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Dependency direction (handbook chapter 05).
              Allowed DataOrbit modules: none (foundational module).
              Every other DataOrbit module is banned, directly or transitively, in any scope.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-direction</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>configuration may depend only on these DataOrbit modules: none (foundational module). See docs/book/chapters/05-the-modular-monolith-and-its-boundaries.md.</message>
                                    <excludes>
                                        <exclude>${project.groupId}:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
