# Keep small synthetic CSV/TSV test fixtures trackable.
!**/src/test/resources/**/*.csv
!**/src/test/resources/**/*.tsv
!**/test/fixtures/**/*.csv
!**/test/fixtures/**/*.tsv
!**/tests/fixtures/**/*.csv
!**/tests/fixtures/**/*.tsv

