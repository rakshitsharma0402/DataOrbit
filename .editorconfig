root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Preserve byte-exact parser fixtures, including invalid encodings and line endings.
[*.{csv,tsv}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
